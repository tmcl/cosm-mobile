{
  "name": "cosm-android",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "tsc --noEmit && REACT_NATIVE_PACKAGER_HOSTNAME=silverfish.tmcl.dev APP_VARIANT=development yarn expo run:android  --app-id dev.tmcl.cosm.dev --binary=$(nom build .#android.development  --out-link development-apk --print-out-paths)/fake-signed-debug-apk.apk",
    "androidDevelopment": "tsc --noEmit && REACT_NATIVE_PACKAGER_HOSTNAME=silverfish.tmcl.dev APP_VARIANT=development yarn expo run:android  --app-id dev.tmcl.cosm.dev",
    "androidRelease": "expo run:android --variant Release",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "tsc --noEmit; R1=$?; npx eslint --max-warnings=0; R2=$?; exit $(( $R1 + R2 ))",
    "format": "find -not '(' -name node_modules -prune -o -name android -prune ')' '(' -iname '*.ts' -o -iname '*.tsx' ')' -print0 | xargs -0 npx prettier --write"
  },
  "dependencies": {
